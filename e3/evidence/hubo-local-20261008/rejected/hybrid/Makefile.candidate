CC ?= cc
CFLAGS = -O0 -Wall -Wextra
HEADERS = unused.h config.h

all: app

app: main.o
	$(CC) main.o -o app

main.o: main.c $(HEADERS)
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -f app main.o main.d

.PHONY: all clean

.PHONY: reject-me
all: reject-me
reject-me:
	@echo E3_INVALID_CANDIDATE >&2
	@false
